{
  "info": {
    "name": "arctic_dark",
    "description": "Frosty dark theme based on the nord color scheme"
  },
  "params": {
    "grid": {
      "draw": true,
      "axis": "both",
      "width": 0.4
    },
    "fonts": {
      "family": "sans-serif",
      "sans-serif": ["Helvetica Neue", "Arial"],
      "size": 12
    },
    "lines": {
      "width": 1.75
    },
    "axes": {
      "width": 1,
      "bottom": true,
      "top": false,
      "left": true,
      "right": false,
      "xmargin": 0.05,
      "ymargin": 0.05
    },
    "axis_labels": {
      "pad": 5.0
    },
    "ticks": {
      "draw_minor": true,
      "pad_major": 1,
      "pad_minor": 1
    },
    "tick_labels": {},
    "colors": {
      "figure_background_color": "#3B4252",
      "plot_background_color": "#4C566A",
      "text_color": "#ECEFF4",
      "axes_color": "#D8DEE9",
      "line_color": "#D8DEE9",
      "grid_color": "#ECEFF4",
      "tick_color": "#D8DEE9",
      "tick_label_color": "#ECEFF4",
      "palette": [
        "#5e81ac",
        "#bf616a",
        "#a3be8c",
        "#d08770",
        "#88c0d0",
        "#b48ead",
        "#ebcb8b",
        "#81a1c1",
        "#8fbcbb"
      ]
    }
  },
  "overrides": {},
  "transforms": {
    "trim": {
      "axis": "both"
    },
    "offset": {
      "distance": 10
    }
  }
}
